# ── Django ─────────────────────────────────────────────────────────────────────
DJANGO_ENV=local
SECRET_KEY=your-secret-key-here

# ── Database ───────────────────────────────────────────────────────────────────
DB_NAME=smerfume
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# ── SMS / OTP ──────────────────────────────────────────────────────────────────
# Master cost-control switch. Keep False in dev/staging — OTP will print to console.
# Set to True in production only.
SEND_REAL_OTP=False
# Dotted class path of the SMS provider. Change this env var to switch vendors.
# No code changes needed — the service layer resolves this dynamically.
SMS_BACKEND=apps.accounts.providers.msg91.MSG91SMSBackend
# MSG91 credentials — only needed when SEND_REAL_OTP=True
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=SMRFME

# ── AWS S3 File Storage ────────────────────────────────────────────────────────
# Set USE_S3=True to store media files on S3 instead of local disk.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
