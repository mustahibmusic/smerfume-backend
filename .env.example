# Smerfume backend: deployment environment reference.
# Variable names with SAFE SAMPLE VALUES ONLY. Never put real secrets here.
# Set real values in the hosting provider's environment settings.
# docs/DEPLOYMENT.md explains each group.

# ── Environment ────────────────────────────────────────────────────────────
# production | staging | uat (required; local is for development)
DJANGO_ENV=production
SECRET_KEY=change-me-to-a-long-random-value

# ── Hosts, HTTPS, proxy ────────────────────────────────────────────────────
ALLOWED_HOSTS=api.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
CORS_ALLOWED_ORIGINS=https://www.example.com
# only if the proxy in front always sets X-Forwarded-Proto
TRUST_PROXY_SSL_HEADER=True
# number of trusted proxies in front (client IP for throttling)
NUM_PROXIES=1
# raise gradually once HTTPS is proven (docs/DEPLOYMENT.md)
SECURE_HSTS_SECONDS=300

# ── Database (PostgreSQL) ──────────────────────────────────────────────────
DATABASE_URL=postgres://smerfume:change-me@db.example.com:5432/smerfume?sslmode=require
# Fallback when DATABASE_URL is unset (local development):
# DB_NAME=smerfume
# DB_USER=smerfume
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432
# DB_SSLMODE=require
CONN_MAX_AGE=60

# ── Redis (DRF throttle counters) ──────────────────────────────────────────
REDIS_URL=rediss://default:change-me@redis.example.com:6379/0

# ── Object storage (S3-compatible: AWS S3, Cloudflare R2, Backblaze B2) ────
# MANDATORY in production: it refuses to start unless USE_S3=True with two
# different buckets and credentials. Optional in staging/uat and local.
USE_S3=True
AWS_ACCESS_KEY_ID=example-access-key-id
AWS_SECRET_ACCESS_KEY=example-secret-access-key
AWS_STORAGE_BUCKET_NAME=smerfume-public
AWS_PRIVATE_STORAGE_BUCKET_NAME=smerfume-private
# leave blank for AWS S3
AWS_S3_ENDPOINT_URL=https://example-account.r2.cloudflarestorage.com
# public bucket host, no scheme
AWS_S3_CUSTOM_DOMAIN=media.example.com
# ap-south-1 for AWS Mumbai
AWS_S3_REGION_NAME=auto
# "path" only if the provider needs it
AWS_S3_ADDRESSING_STYLE=

# ── Web server ─────────────────────────────────────────────────────────────
PORT=8000
WEB_CONCURRENCY=1
GUNICORN_TIMEOUT=120
LOG_LEVEL=INFO

# ── SMS (OTP) ──────────────────────────────────────────────────────────────
SEND_REAL_OTP=False
SMS_BACKEND=apps.accounts.providers.msg91.MSG91SMSBackend
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=SMRFME
OTP_MAX_SENDS_PER_MOBILE_PER_HOUR=5

# ── Admin and features ─────────────────────────────────────────────────────
ADMIN_ENVIRONMENT=
ADMIN_SITE_URL=https://www.example.com
BOOKED_INCOMING_SALES_ENABLED=False

# ── Parfumly catalogue import (management command only; optional) ──────────
# PARFUMLY_API_BASE_URL=https://api.parfumly.in
# PARFUMLY_REQUEST_DELAY_SECONDS=0.5
# PARFUMLY_TIMEOUT_SECONDS=20
