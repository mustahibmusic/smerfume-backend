# ── Python ─────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Virtual environment ─────────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Environment / secrets ───────────────────────────────────────────────────────
# No .env* files are committed — keys and values are both kept private.
.env
.env.*

# ── Django ──────────────────────────────────────────────────────────────────────
*.log
local_settings.py
db.sqlite3
media/
staticfiles/

# ── Database dumps / backups / keys / archives ─────────────────────────────────
# Never commit database exports, backups, private keys or certificates.
*.sql
*.dump
*.backup
*.bak
*.pem
*.key
*.zip
*.gz

# ── IDEs / AI tooling ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.claude/*
!.claude/CLAUDE.md
.code-review-graph/

# ── OS ──────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
